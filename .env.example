# Sentinel RT&WS WITSML DataStore - configuración local
# Copiar a .env y ajustar. Ningún secreto se versiona.

SENTINEL_ENV=development
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_LOG_LEVEL=INFO
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev@localhost:5432/sentinel
SENTINEL_ADMIN_ORIGIN=http://localhost:3000
SENTINEL_PUBLIC_BASE_URL=http://localhost:8000
SENTINEL_MAIL_WORKER_INTERVAL_SECONDS=5

# TLS: en producción debe quedar en true. El adaptador WMLS rechaza HTTP sin TLS.
SENTINEL_REQUIRE_HTTPS=false
SENTINEL_TRUST_FORWARDED_PROTO=true
SENTINEL_COOKIE_SECURE=false

# SMTP (Zoho). El worker de correo es independiente de WMLS.
SENTINEL_SMTP_HOST=smtp.zoho.com
SENTINEL_SMTP_PORT=587
SENTINEL_SMTP_USER=
SENTINEL_SMTP_PASSWORD=
SENTINEL_SMTP_FROM=no-reply@example.com

# Suite oficial de autoevaluación (fuera del árbol de código)
SENTINEL_WPCTT_DIR=
